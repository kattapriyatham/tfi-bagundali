# Copy to `.env` and fill in real values:  cp .env.example .env
#
# Every KEY=VALUE here is injected into the Flutter app at build time as a
# --dart-define by scripts/run_dev.sh. Read them in Dart with:
#   const String.fromEnvironment("KEY")
#
# Lines starting with # are ignored. Quotes around values are optional and
# are stripped. Do NOT commit .env (it is gitignored).

# --- General ---
APP_ENV=dev

# --- Android emulator used by scripts/run_dev.sh ---
# AVD id from `flutter emulators`. Override without editing this file:
#   ANDROID_EMULATOR=Pixel_7_API_34 ./scripts/run_dev.sh
ANDROID_EMULATOR=Medium_Phone_API_35

# --- Firebase (online multiplayer) ---
# Set to true to point the app at a locally running Firebase Local Emulator
# Suite (`firebase emulators:start`) instead of the real spndex-37b0d
# project. Automated tests always pass this via scripts/test_online.sh.
USE_FIREBASE_EMULATOR=false
